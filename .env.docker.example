DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
DEBUG=False
# Підстав реальний IPv4 Droplet. Не лишай слово DROPLET_IP.
ALLOWED_HOSTS=127.0.0.1,localhost,backend
SITE_URL=
CSRF_TRUSTED_ORIGINS=http://127.0.0.1
DATABASE_URL=postgres://gestia:CHANGE_ME@db:5432/gestia
POSTGRES_DB=gestia
POSTGRES_USER=gestia
# Без @ : / # % і пробілу: інакше DATABASE_URL у Compose розбирається криво.
POSTGRES_PASSWORD=CHANGE_ME
USE_HTTPS=false
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
TRUST_X_FORWARDED_FOR=True
ADMIN_URL=change-me/
DEFAULT_FROM_EMAIL=shop@example.com
ORDER_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ключ API Нової пошти. Порожній — сайт працює на локальному каталозі або демо-підказках.
# Повний список відділень: python manage.py sync_nova_poshta
NOVA_POSHTA_API_KEY=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=0
LIQPAY_ALLOW_SHA1_FALLBACK=0
DOMAIN=

# Після DNS і certbot:
# DOMAIN=example.com
# USE_HTTPS=true
# SITE_URL=https://example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# ALLOWED_HOSTS=example.com,www.example.com,203.0.113.10,127.0.0.1,localhost,backend
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
